# EY SophIA Live — environment variables
# Copy to .env.local and fill with your Supabase project values.

# --- Supabase (NEW key scheme) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# PUBLISHABLE key (sb_publishable_...) — safe for the browser, subject to RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET key (sb_secret_...) — SERVER ONLY. Bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Vercel Cron ---
# Shared secret the keep-alive cron sends to authenticate its daily ping.
CRON_SECRET=

# --- Admin allowlist (dev convenience) ---
# Comma-separated emails granted admin access before the `admins` table exists.
# In production, the `admins` table + RLS is the source of truth.
ADMIN_ALLOWLIST=
